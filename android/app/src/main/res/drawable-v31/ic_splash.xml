<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash: the sun rises, then the cross is drawn in. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="all"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.82"
                android:scaleY="0.82">
                <path
                    android:name="sun"
                    android:pathData="M29,63 A25,25 0 0,1 79,63"
                    android:strokeWidth="4.5"
                    android:strokeColor="#FFE8A33D"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0" />
                <path
                    android:name="upright"
                    android:pathData="M54,79 L54,31"
                    android:strokeWidth="8"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0" />
                <path
                    android:name="beam"
                    android:pathData="M40,45 L68,45"
                    android:strokeWidth="8"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="all">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="850"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.82"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="850"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.82"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="sun">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="520"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="upright">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="340"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="300"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="beam">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="560"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
